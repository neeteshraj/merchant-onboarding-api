{
  "name": "merchant-onboarding-api",
  "version": "1.0.0",
  "description": "Merchant application onboarding and risk review API",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch-path=dist --enable-source-maps dist/main.js)",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config test/jest-e2e.config.js --runInBand",
    "typeorm": "node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/database/data-source.js",
    "migration:generate": "yarn build && yarn typeorm migration:generate",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "seed": "node --env-file-if-exists=.env dist/database/seed.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/typeorm": "^12.0.3",
    "bullmq": "^6.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.9.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.18.1"
}
