NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=merchant
DB_PASSWORD=change-me
DB_NAME=merchant_onboarding

REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_PREFIX=bull

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

RISK_REVIEW_MAX_ATTEMPTS=5
RISK_REVIEW_BACKOFF_MS=1000
KYB_TRANSIENT_FAILURE_RATE=0.2

# Shared with the KYB provider to sign callbacks (min 32 chars, generate like JWT_SECRET)
KYB_WEBHOOK_SECRET=
KYB_WEBHOOK_TOLERANCE_SECONDS=300

# Audit storage backend: postgres | mongo
AUDIT_STORE=postgres
MONGO_PORT=27017
MONGO_ROOT_USER=merchant
MONGO_ROOT_PASSWORD=change-me
MONGO_URL=mongodb://merchant:change-me@localhost:27017/?authSource=admin
MONGO_DB_NAME=merchant_onboarding

# Password assigned to all demo users by `yarn seed` (min 12 chars)
SEED_USER_PASSWORD=
